<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Template name="GodCard" src="GodCard.uxml" />
    <ui:Template name="NationRow" src="NationRow.uxml" />
    <ui:Style src="Styles/Tokens.uss" />
    <ui:Style src="Match.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <!-- Empty and invisible: the free table the board must fit in, between the left column, the
             combat panel and the bottom actions. BoardCameraFit reads its rectangle, so no panel can
             cover the board at any aspect ratio. Its margins are the board-gutter tokens. -->
        <ui:VisualElement name="board-area" class="hud__board-area" picking-mode="Ignore" />
        <!-- Left column: who you are, then every nation at a glance. -->
        <ui:VisualElement class="hud__left" picking-mode="Ignore">
            <ui:VisualElement name="identity-card" class="card hud__identity" picking-mode="Ignore">
                <!-- Only the key facts: who you are, your two numbers and your Wrath with its Favor.
                     The goal and the powers' full rules live in the info panels (round line, nation rows).
                     The chip sits on the name line (same head as a nation row), centered with it. -->
                <ui:VisualElement class="hud__identity-text" picking-mode="Ignore">
                    <ui:VisualElement class="hud__identity-head" picking-mode="Ignore">
                        <ui:VisualElement name="identity-chip" class="god-chip god-chip--sm god--zeus" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="identity-label" class="hud__identity-name" picking-mode="Ignore" text="ZEUS" />
                    </ui:VisualElement>
                    <ui:VisualElement class="hud__identity-row" picking-mode="Ignore">
                        <ui:VisualElement class="omen-icon omen-icon--sacred hud__identity-icon" picking-mode="Ignore" />
                        <ui:Label name="identity-sacred-label" class="hud__identity-line" picking-mode="Ignore" text="1 sacred" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed hud__identity-icon hud__identity-icon--second" picking-mode="Ignore" />
                        <ui:Label name="identity-cursed-label" class="hud__identity-line" picking-mode="Ignore" text="6 cursed" />
                    </ui:VisualElement>
                    <!-- Pantheon powers only: the human's Wrath (carved name) and its Favor stars, on the god's
                         tint (god class set by HudView). The Wrath button says when it is ready. -->
                    <ui:VisualElement name="identity-wrath" class="hud__wrath god--zeus" picking-mode="Ignore">
                        <ui:Label name="identity-wrath-name" class="hud__wrath-name" picking-mode="Ignore" text="Thunderbolt" />
                        <ui:Label name="identity-favor" class="hud__favor" picking-mode="Ignore" text="★★☆" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Rows in base cycle order, named after the God enum. The goal caption heads them. -->
            <ui:VisualElement name="nations-panel" class="card nations-panel" picking-mode="Ignore">
                <ui:Label name="nations-goal" class="nations-panel__goal" picking-mode="Ignore" text="First to hold 3 temples wins" />
                <ui:Instance template="NationRow" name="nation-zeus" picking-mode="Ignore" />
                <ui:Instance template="NationRow" name="nation-ra" picking-mode="Ignore" />
                <ui:Instance template="NationRow" name="nation-thor" picking-mode="Ignore" />
                <ui:Instance template="NationRow" name="nation-morrigan" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hud__top" picking-mode="Ignore">
            <!-- The round line is a toggle: a click (or the "i") opens the round info panel below it. -->
            <ui:VisualElement name="round-bar" class="card hud__round info-toggle">
                <!-- The Destiny line (h2), then the round counter under it (label, secondary). -->
                <ui:VisualElement class="hud__round-lines" picking-mode="Ignore">
                    <ui:Label name="round-label" class="hud__round-text" picking-mode="Ignore" text="Destiny 2: Day of Ra, Morrígan −2" />
                    <ui:Label name="round-counter" class="hud__round-counter" picking-mode="Ignore" text="ROUND 1/15" />
                </ui:VisualElement>
                <ui:Label class="info-badge" picking-mode="Ignore" text="i" />
            </ui:VisualElement>
            <!-- A Day that lasts the whole round (Ragnarök, Night of crows); god class set by HudView. -->
            <ui:Label name="day-badge" class="hud__day-badge god--thor" picking-mode="Ignore" text="Ragnarök: Thor wins ties, his wins cost 2" />
            <!-- What this round means, in full sentences. Pickable while open (a click on it closes it). Text set by HudView. -->
            <ui:VisualElement name="round-info" class="card info-panel round-info">
                <ui:Label name="round-info-title" class="info-panel__heading" picking-mode="Ignore" text="DESTINY 2 · RA'S SACRED NUMBER" />
                <ui:VisualElement name="round-info-zeus" class="round-info__god" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip god-chip--sm god--zeus" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="info-panel__text round-info__god-text" picking-mode="Ignore" text="&lt;b&gt;Zeus:&lt;/b&gt; no change" />
                </ui:VisualElement>
                <ui:VisualElement name="round-info-ra" class="round-info__god" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip god-chip--sm god--ra" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="info-panel__text round-info__god-text" picking-mode="Ignore" text="&lt;b&gt;Ra:&lt;/b&gt; favored, Sun at noon instead of +2 reinforcements" />
                </ui:VisualElement>
                <ui:VisualElement name="round-info-thor" class="round-info__god" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip god-chip--sm god--thor" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="info-panel__text round-info__god-text" picking-mode="Ignore" text="&lt;b&gt;Thor:&lt;/b&gt; no change" />
                </ui:VisualElement>
                <ui:VisualElement name="round-info-morrigan" class="round-info__god" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip god-chip--sm god--morrigan" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label class="info-panel__text round-info__god-text" picking-mode="Ignore" text="&lt;b&gt;Morrígan:&lt;/b&gt; weakened, -2 reinforcements" />
                </ui:VisualElement>
                <ui:Label name="round-info-opener-heading" class="info-panel__heading" picking-mode="Ignore" text="WHO OPENS" />
                <ui:Label name="round-info-opener" class="info-panel__text" picking-mode="Ignore" text="Ra opens: Destiny showed 2, Ra's sacred number. Then Thor, Morrígan, Zeus." />
                <ui:Label name="round-info-day-heading" class="info-panel__heading" picking-mode="Ignore" text="DAY OF RA · SUN AT NOON" />
                <ui:Label name="round-info-day" class="info-panel__text" picking-mode="Ignore" text="Every Ra territory gains +1 troop at once, instead of Ra's +2 reinforcements." />
                <ui:Label name="round-info-goal-heading" class="info-panel__heading" picking-mode="Ignore" text="GOAL" />
                <ui:Label name="round-info-goal" class="info-panel__text" picking-mode="Ignore" text="Hold 3 of the 4 temples at the start of your turn to win." />
                <ui:Label name="round-info-close" class="info-panel__close" picking-mode="Ignore" text="Click or Esc to close" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="hud__bottom" picking-mode="Ignore">
            <!-- The one prompt component: the acting god's chip and color edge, a small label ("YOUR TURN",
                 "SACRED ROAD") over the instruction. Hidden when there is nothing to say and on bot turns
                 (the turn box says whose turn it is). God class set by HudView. -->
            <ui:VisualElement name="prompt-bar" class="prompt god--zeus" picking-mode="Ignore">
                <ui:VisualElement name="prompt-chip" class="god-chip god--zeus" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="prompt__text" picking-mode="Ignore">
                    <ui:Label name="prompt-turn" class="prompt__turn" picking-mode="Ignore" text="YOUR TURN" />
                    <ui:Label name="prompt-label" class="prompt__instruction" picking-mode="Ignore" text="" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Three slots, so the center (END TURN, or the counter while reinforcing) sits at the exact
                 bottom center whatever the Wrath button beside it shows. -->
            <ui:VisualElement class="hud__actions" picking-mode="Ignore">
                <ui:VisualElement class="hud__actions-side hud__actions-side--left" picking-mode="Ignore">
                    <!-- The god's signature power: icon, carved name over its state, three Favor stars.
                         Locked / ready / used / aiming classes and the god class are set by HudView. -->
                    <ui:Button name="wrath-button" class="button wrath god--zeus">
                        <ui:VisualElement class="wrath__halo" picking-mode="Ignore" />
                        <ui:VisualElement class="wrath__icon god-chip__icon" picking-mode="Ignore" />
                        <ui:VisualElement class="wrath__text" picking-mode="Ignore">
                            <ui:Label name="wrath-name" class="wrath__name" picking-mode="Ignore" text="THUNDERBOLT" />
                            <ui:Label name="wrath-state" class="wrath__state" picking-mode="Ignore" text="FAVOR 1/3" />
                        </ui:VisualElement>
                        <ui:VisualElement name="wrath-stars" class="wrath__stars" picking-mode="Ignore">
                            <ui:VisualElement class="wrath__star wrath__star--on" picking-mode="Ignore">
                                <ui:VisualElement class="wrath__star-back" picking-mode="Ignore" />
                                <ui:VisualElement class="wrath__star-front" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="wrath__star" picking-mode="Ignore">
                                <ui:VisualElement class="wrath__star-back" picking-mode="Ignore" />
                                <ui:VisualElement class="wrath__star-front" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement class="wrath__star" picking-mode="Ignore">
                                <ui:VisualElement class="wrath__star-back" picking-mode="Ignore" />
                                <ui:VisualElement class="wrath__star-front" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="hud__actions-center" picking-mode="Ignore">
                    <!-- While the human reinforces: troops still to place, in a die-like token that pops on every
                         placement, and where they came from on the line under the caption. -->
                    <ui:VisualElement name="reinforce-counter" class="card reinforce-counter" picking-mode="Ignore">
                        <ui:Label name="reinforce-count" class="reinforce-counter__count" picking-mode="Ignore" text="5" />
                        <ui:VisualElement class="reinforce-counter__text" picking-mode="Ignore">
                            <ui:Label name="reinforce-caption" class="reinforce-counter__label" picking-mode="Ignore" text="TROOPS TO PLACE" />
                            <ui:Label name="reinforce-formula" class="reinforce-counter__formula" picking-mode="Ignore" text="2 base + 1 for 2 territories + 2 Destiny" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="end-turn-button" text="END TURN" class="button button--primary button--end-turn" />
                </ui:VisualElement>
                <ui:VisualElement class="hud__actions-side" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Toasts in the right gutter's free corner: what a power just did (god class set by HudView; a
             Favor change leads with the drawn omen icon, never the ✗ glyph) and the one-time hint. -->
        <ui:VisualElement class="hud__toasts" picking-mode="Ignore">
            <ui:VisualElement name="news" class="hud__news god--zeus hud__news--sacred" picking-mode="Ignore">
                <ui:VisualElement class="omen-icon omen-icon--sacred hud__news-icon hud__news-icon--sacred" picking-mode="Ignore" />
                <ui:VisualElement class="omen-icon omen-icon--cursed hud__news-icon hud__news-icon--cursed" picking-mode="Ignore" />
                <ui:Label name="news-label" class="hud__news-text" picking-mode="Ignore" text="1 sacred: +1 Favor (2/3)" />
            </ui:VisualElement>
            <ui:Label name="hint-label" class="hud__hint" picking-mode="Ignore" text="Roll your sacred number in combat to earn Favor" />
        </ui:VisualElement>
        <ui:VisualElement name="dice-panel" class="card dice-panel" picking-mode="Ignore">
            <ui:Label name="dice-title" class="dice-panel__title" picking-mode="Ignore" />
            <ui:VisualElement class="dice-panel__row" picking-mode="Ignore">
                <ui:VisualElement class="die-slot" picking-mode="Ignore">
                    <ui:Label name="attacker-name" class="die-slot__name" picking-mode="Ignore" />
                    <ui:VisualElement name="attacker-die" class="die" picking-mode="Ignore">
                        <ui:VisualElement class="die__crack" picking-mode="Ignore" />
                        <ui:Label name="attacker-face" class="die__face" picking-mode="Ignore" text="1" />
                        <ui:VisualElement class="omen-icon omen-icon--sacred die__mark die__mark--sacred" picking-mode="Ignore" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed die__mark die__mark--cursed" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <!-- Outcome tag: drawn icon (sacred / cursed only) + word. Outcome class set by DiceView. -->
                    <ui:VisualElement name="attacker-outcome" class="outcome" picking-mode="Ignore">
                        <ui:VisualElement class="omen-icon omen-icon--sacred outcome__icon outcome__icon--sacred" picking-mode="Ignore" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed outcome__icon outcome__icon--cursed" picking-mode="Ignore" />
                        <ui:Label name="attacker-outcome-label" class="outcome__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="die-slot" picking-mode="Ignore">
                    <ui:Label name="defender-name" class="die-slot__name" picking-mode="Ignore" />
                    <ui:VisualElement name="defender-die" class="die" picking-mode="Ignore">
                        <ui:VisualElement class="die__crack" picking-mode="Ignore" />
                        <ui:Label name="defender-face" class="die__face" picking-mode="Ignore" text="1" />
                        <ui:VisualElement class="omen-icon omen-icon--sacred die__mark die__mark--sacred" picking-mode="Ignore" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed die__mark die__mark--cursed" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement name="defender-outcome" class="outcome" picking-mode="Ignore">
                        <ui:VisualElement class="omen-icon omen-icon--sacred outcome__icon outcome__icon--sacred" picking-mode="Ignore" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed outcome__icon outcome__icon--cursed" picking-mode="Ignore" />
                        <ui:Label name="defender-outcome-label" class="outcome__label" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Optional Offering under the human's (attacker's) die, shown by DiceView for a short window
                 while they lose; the bar inside drains until the combat confirms by itself. -->
            <ui:Button name="dice-offering-button" class="button button--secondary dice-offering">
                <ui:Label name="dice-offering-label" class="dice-offering__label" picking-mode="Ignore" />
                <ui:VisualElement class="dice-offering__timer" picking-mode="Ignore">
                    <ui:VisualElement name="dice-offering-timer" class="dice-offering__timer-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:Button>
            <!-- The verdict: the winner's chip and tint, the rule that decided it, then up to two badges
                 (Offering re-roll, Ragnarök). Winner class and texts set by DiceView. -->
            <ui:VisualElement name="dice-verdict-box" class="verdict" picking-mode="Ignore">
                <ui:VisualElement name="dice-verdict-chip" class="god-chip god-chip--sm verdict__chip" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="verdict__text" picking-mode="Ignore">
                    <ui:Label name="dice-verdict-kicker" class="verdict__kicker" picking-mode="Ignore" />
                    <ui:Label name="dice-verdict" class="verdict__main" picking-mode="Ignore" />
                    <ui:Label name="dice-badge-offering" class="verdict__badge" picking-mode="Ignore" />
                    <ui:Label name="dice-badge-ragnarok" class="verdict__badge" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Shown by DiceView while the human's own combat result waits for a click. -->
            <ui:Label name="dice-continue" class="dice-panel__continue" picking-mode="Ignore" />
        </ui:VisualElement>
        <!-- The one turn indicator: top right under the toggles, for a bot ("THOR'S TURN" + what it is
             doing) and for a person ("YOUR TURN" / "P2 · ZEUS'S TURN"). God class and texts set by HudView. -->
        <ui:VisualElement name="turn-box" class="card turn-box god--zeus" picking-mode="Ignore">
            <ui:VisualElement name="turn-box-chip" class="god-chip god--zeus" picking-mode="Ignore">
                <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="turn-box__text" picking-mode="Ignore">
                <ui:Label name="turn-box-title" class="turn-box__title" picking-mode="Ignore" text="THOR'S TURN" />
                <ui:Label name="turn-box-status" class="turn-box__status" picking-mode="Ignore" text="Rolling…" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Slides in at the top center when a turn starts (shown class added by TurnBannerView). -->
        <ui:VisualElement name="turn-banner" class="card turn-banner" picking-mode="Ignore">
            <ui:VisualElement name="turn-banner-chip" class="god-chip god--zeus" picking-mode="Ignore">
                <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="turn-banner-label" class="turn-banner__label" picking-mode="Ignore" text="YOUR TURN" />
        </ui:VisualElement>
        <!-- A person's sacred die opens the Sacred Road: slides in at the center (shown class and text set by
             TurnBannerView). Picking Ignore until shown, so it never blocks the board while hidden. -->
        <ui:VisualElement name="road-popup" class="card road-popup" picking-mode="Ignore">
            <!-- One slim row (chip, title, one short sentence, "Click to close"), so it stays inside the
                 table's top margin and never covers a piece or a ring, whatever the aspect ratio. -->
            <ui:VisualElement class="road-popup__head" picking-mode="Ignore">
                <ui:VisualElement name="road-popup-chip" class="god-chip god-chip--sm god--zeus" picking-mode="Ignore">
                    <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="road-popup-title" class="road-popup__title" picking-mode="Ignore" text="SACRED ROAD OPENS" />
                <ui:Label name="road-popup-text" class="road-popup__text" picking-mode="Ignore" text="March an army up to 2 territories" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Round start: the Destiny Die. Pickable while shown, so a click anywhere skips it. -->
        <ui:VisualElement name="destiny-overlay" class="destiny-overlay">
            <ui:VisualElement class="card destiny-card" picking-mode="Ignore">
                <ui:Label name="destiny-title" class="destiny-card__title" picking-mode="Ignore" text="ROUND 1" />
                <ui:VisualElement name="destiny-die" class="die die--destiny" picking-mode="Ignore">
                    <ui:Label name="destiny-face" class="die__face" picking-mode="Ignore" text="2" />
                    <!-- The favored god's chip, shown only on a god's face (USS keys it on the god class). -->
                    <ui:VisualElement name="destiny-chip" class="god-chip destiny-card__chip" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="destiny-effect" class="destiny-card__effect" picking-mode="Ignore" text="Ra favored +2, Morrígan weakened -2 · Ra opens" />
                <!-- Pantheon powers: the god's Day, in that god's color (god class set by DestinyView). -->
                <ui:Label name="destiny-day" class="destiny-card__day god--ra" picking-mode="Ignore" text="Day of Ra: +1 troop on every Ra territory, instead of +2" />
                <!-- What the face does to the human, in their color (god class set by DestinyView). -->
                <ui:Label name="destiny-you" class="destiny-card__you god--zeus" picking-mode="Ignore" text="You: no change" />
                <ui:Label name="destiny-skip" class="destiny-card__skip" picking-mode="Ignore" text="Click to skip" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Main menu over the board. Card instances are named after the God enum. -->
        <ui:VisualElement name="menu" class="menu">
            <ui:VisualElement class="card menu__card" picking-mode="Ignore">
                <ui:Label name="menu-title" class="menu__title" picking-mode="Ignore" text="GodBoard" />
                <ui:Label name="menu-tagline" class="menu__tagline" picking-mode="Ignore" text="Your lucky number is your rival's curse." />
                <!-- Pantheon powers or Classic, then Solo or Hot-seat (1-4 people sharing one screen and mouse):
                     the selected one of each pair is the primary button. Text set by MenuView. -->
                <ui:VisualElement class="menu__modes" picking-mode="Ignore">
                    <ui:Button name="mode-powers-button" text="● PANTHEON POWERS" class="button button--primary menu__mode" />
                    <ui:Button name="mode-classic-button" text="○ CLASSIC" class="button button--secondary menu__mode" />
                    <ui:VisualElement class="menu__modes-divider" picking-mode="Ignore" />
                    <ui:Button name="seats-solo-button" text="● SOLO" class="button button--primary menu__mode" />
                    <ui:Button name="seats-hotseat-button" text="○ HOT-SEAT" class="button button--secondary menu__mode" />
                </ui:VisualElement>
                <ui:Label name="mode-line" class="menu__mode-line" picking-mode="Ignore" text="Your sacred roll in combat earns Favor; at 3, unleash your Wrath. Destiny on a god's number brings its Day." />
                <!-- Solo: "Choose your god" (a card click starts). Hot-seat: a card click switches Human / Bot,
                     and START (shown only then) begins the match. -->
                <ui:VisualElement class="menu__prompt-row" picking-mode="Ignore">
                    <ui:Label name="menu-prompt" class="menu__prompt" picking-mode="Ignore" text="Choose your god" />
                    <ui:Button name="menu-start-button" text="START" class="button button--primary menu__start" />
                </ui:VisualElement>
                <ui:VisualElement class="menu__cards" picking-mode="Ignore">
                    <ui:Instance template="GodCard" name="god-card-zeus" picking-mode="Ignore" />
                    <ui:Instance template="GodCard" name="god-card-ra" picking-mode="Ignore" />
                    <ui:Instance template="GodCard" name="god-card-thor" picking-mode="Ignore" />
                    <ui:Instance template="GodCard" name="god-card-morrigan" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- The sacred-number rule in one sentence over three rows; the drawn omen icons replace the glyphs. Text set by MenuView. -->
                <ui:VisualElement class="menu__rule" picking-mode="Ignore">
                    <ui:VisualElement class="menu__rule-row" picking-mode="Ignore">
                        <ui:Label name="rule-sacred-lead" class="menu__rule-text" picking-mode="Ignore" text="Each god has a" />
                        <ui:VisualElement class="omen-icon omen-icon--sacred menu__rule-icon" picking-mode="Ignore" />
                        <ui:Label name="rule-sacred" class="menu__rule-text" picking-mode="Ignore" text="sacred number (beats any neutral roll)" />
                    </ui:VisualElement>
                    <ui:VisualElement class="menu__rule-row" picking-mode="Ignore">
                        <ui:Label name="rule-cursed-lead" class="menu__rule-text" picking-mode="Ignore" text="and a" />
                        <ui:VisualElement class="omen-icon omen-icon--cursed menu__rule-icon" picking-mode="Ignore" />
                        <ui:Label name="rule-cursed" class="menu__rule-text" picking-mode="Ignore" text="cursed number (loses to any neutral roll)." />
                    </ui:VisualElement>
                    <ui:VisualElement class="menu__rule-row" picking-mode="Ignore">
                        <ui:Label name="rule-rival" class="menu__rule-text" picking-mode="Ignore" text="Your cursed number is your rival's sacred one." />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="end-banner" class="end-banner">
            <ui:VisualElement name="end-card" class="card end-banner__card" picking-mode="Ignore">
                <ui:Label name="winner-label" class="end-banner__title" picking-mode="Ignore" text="YOU WIN" />
                <!-- Winner card: chip, name and why. Tinted by the god class on end-card. -->
                <ui:VisualElement class="end-winner" picking-mode="Ignore">
                    <ui:VisualElement name="winner-chip" class="god-chip god-chip--lg god--zeus" picking-mode="Ignore">
                        <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="end-winner__text" picking-mode="Ignore">
                        <ui:Label name="winner-name" class="end-banner__winner" picking-mode="Ignore" text="Zeus wins" />
                        <ui:Label name="reason-label" class="end-banner__reason" picking-mode="Ignore" text="Held 3 temples at the start of the turn" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="end-stats" picking-mode="Ignore">
                    <ui:VisualElement name="stat-rounds" class="end-stat" picking-mode="Ignore">
                        <ui:Label name="stat-rounds-value" class="end-stat__value" picking-mode="Ignore" text="7" />
                        <ui:Label name="stat-rounds-label" class="end-stat__label" picking-mode="Ignore" text="rounds" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-temples" class="end-stat" picking-mode="Ignore">
                        <ui:Label name="stat-temples-value" class="end-stat__value" picking-mode="Ignore" text="3" />
                        <ui:Label name="stat-temples-label" class="end-stat__label" picking-mode="Ignore" text="Zeus's temples" />
                    </ui:VisualElement>
                    <ui:VisualElement name="stat-combats" class="end-stat" picking-mode="Ignore">
                        <ui:Label name="stat-combats-value" class="end-stat__value" picking-mode="Ignore" text="5" />
                        <ui:Label name="stat-combats-label" class="end-stat__label" picking-mode="Ignore" text="combats you won" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="end-banner__actions" picking-mode="Ignore">
                    <ui:Button name="play-again-button" text="PLAY AGAIN" class="button button--primary" />
                    <ui:Button name="main-menu-button" text="MAIN MENU" class="button button--secondary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- The turn-order draw, before round 1: two dice per duel (god chip, die, short tag, boxed verdict),
             then the final order as four numbered god cards. Pickable while shown: a click skips to the order.
             Texts and classes set by TurnOrderView. -->
        <ui:VisualElement name="draw-overlay" class="draw-overlay">
            <ui:VisualElement class="card draw-card" picking-mode="Ignore">
                <ui:Label name="draw-title" class="draw-card__title" picking-mode="Ignore" text="TURN ORDER" />
                <ui:Label name="draw-duel" class="draw-card__duel" picking-mode="Ignore" text="Zeus vs Thor" />
                <ui:VisualElement name="draw-duel-block" class="draw-card__block" picking-mode="Ignore">
                    <ui:VisualElement class="draw-card__row" picking-mode="Ignore">
                        <ui:VisualElement class="die-slot" picking-mode="Ignore">
                            <ui:VisualElement name="draw-chip-a" class="god-chip god--zeus" picking-mode="Ignore">
                                <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="draw-name-a" class="die-slot__name" picking-mode="Ignore" />
                            <ui:VisualElement name="draw-die-a" class="die" picking-mode="Ignore">
                                <ui:VisualElement class="die__crack" picking-mode="Ignore" />
                                <ui:Label name="draw-face-a" class="die__face" picking-mode="Ignore" text="1" />
                                <ui:VisualElement class="omen-icon omen-icon--sacred die__mark die__mark--sacred" picking-mode="Ignore" />
                                <ui:VisualElement class="omen-icon omen-icon--cursed die__mark die__mark--cursed" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="draw-outcome-a" class="outcome" picking-mode="Ignore">
                                <ui:VisualElement class="omen-icon omen-icon--sacred outcome__icon outcome__icon--sacred" picking-mode="Ignore" />
                                <ui:VisualElement class="omen-icon omen-icon--cursed outcome__icon outcome__icon--cursed" picking-mode="Ignore" />
                                <ui:Label name="draw-outcome-label-a" class="outcome__label" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="die-slot" picking-mode="Ignore">
                            <ui:VisualElement name="draw-chip-b" class="god-chip god--thor" picking-mode="Ignore">
                                <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label name="draw-name-b" class="die-slot__name" picking-mode="Ignore" />
                            <ui:VisualElement name="draw-die-b" class="die" picking-mode="Ignore">
                                <ui:VisualElement class="die__crack" picking-mode="Ignore" />
                                <ui:Label name="draw-face-b" class="die__face" picking-mode="Ignore" text="1" />
                                <ui:VisualElement class="omen-icon omen-icon--sacred die__mark die__mark--sacred" picking-mode="Ignore" />
                                <ui:VisualElement class="omen-icon omen-icon--cursed die__mark die__mark--cursed" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:VisualElement name="draw-outcome-b" class="outcome" picking-mode="Ignore">
                                <ui:VisualElement class="omen-icon omen-icon--sacred outcome__icon outcome__icon--sacred" picking-mode="Ignore" />
                                <ui:VisualElement class="omen-icon omen-icon--cursed outcome__icon outcome__icon--cursed" picking-mode="Ignore" />
                                <ui:Label name="draw-outcome-label-b" class="outcome__label" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="draw-verdict-box" class="verdict draw-card__verdict" picking-mode="Ignore">
                        <ui:VisualElement name="draw-verdict-chip" class="god-chip god-chip--sm verdict__chip" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="verdict__text" picking-mode="Ignore">
                            <ui:Label name="draw-verdict" class="verdict__main" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="draw-final" class="draw-card__final" picking-mode="Ignore">
                    <ui:VisualElement class="draw-place" picking-mode="Ignore">
                        <ui:Label class="draw-place__badge" picking-mode="Ignore" text="1st" />
                        <ui:VisualElement class="god-chip god-chip--lg draw-place__chip" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="draw-place__name" picking-mode="Ignore" text="Zeus" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draw-place" picking-mode="Ignore">
                        <ui:Label class="draw-place__badge" picking-mode="Ignore" text="2nd" />
                        <ui:VisualElement class="god-chip god-chip--lg draw-place__chip" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="draw-place__name" picking-mode="Ignore" text="Ra" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draw-place" picking-mode="Ignore">
                        <ui:Label class="draw-place__badge" picking-mode="Ignore" text="3rd" />
                        <ui:VisualElement class="god-chip god-chip--lg draw-place__chip" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="draw-place__name" picking-mode="Ignore" text="Thor" />
                    </ui:VisualElement>
                    <ui:VisualElement class="draw-place" picking-mode="Ignore">
                        <ui:Label class="draw-place__badge" picking-mode="Ignore" text="4th" />
                        <ui:VisualElement class="god-chip god-chip--lg draw-place__chip" picking-mode="Ignore">
                            <ui:VisualElement class="god-chip__icon" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label class="draw-place__name" picking-mode="Ignore" text="Morrígan" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="draw-skip" class="destiny-card__skip draw-card__skip" picking-mode="Ignore" text="Click to skip" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Last, so the sound toggle draws above the main menu overlay. -->
        <ui:VisualElement name="hud-toggles" class="hud__toggles" picking-mode="Ignore">
            <ui:Button name="mute-button" text="SOUND: ON" class="button button--secondary hud__toggle" />
            <ui:Button name="fast-bots-button" text="▶▶ FAST BOTS: OFF" class="button button--secondary hud__toggle" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
