/* Match HUD, menu and modals. Every value comes from Styles/Tokens.uss.
   Text sizes per screen (dice excluded):
   - HUD: h2 (round line, turn banner, temple dots), body (identity, prompt, hint, verdict, info panels),
     label (buttons, tags, stats, info headings). The reinforcement counter's number is a die-like token,
     so like the dice it sits outside the count (h1).
     The round line is Inter, not Cinzel: Cinzel's 1 reads as an I, and that line is all numbers.
   - Menu: display (title), h2 (god names), body (tagline, prompt, card lines).
   - Destiny Die: h1 (round), body (effect, your effect), caption (skip hint).
   - End screen: h1 (verdict, stat values), body (winner, reason), label (stat names, buttons).
   Typefaces: Cinzel (--font-display) for display / h1 / h2 and die faces; Inter for everything else. */

.hud {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: var(--space-8);
    justify-content: space-between;
    -unity-font-definition: var(--font-body);
}

/* The free table the board is fitted into (BoardCameraFit reads this rectangle): the screen minus the
   left column, the combat panel, the round line and the bottom actions. Never drawn, never clickable. */
.hud__board-area {
    position: absolute;
    left: var(--board-gutter-left);
    right: var(--board-gutter-right);
    top: var(--board-gutter-top);
    bottom: var(--board-gutter-bottom);
}

/* Carved display capitals: only at h2 size and up. */
.menu__title,
.god-card__name,
.turn-banner__label,
.road-popup__title,
.end-banner__title {
    -unity-font-definition: var(--font-display);
}

/* Numbers never use Cinzel: its "1" reads like "I" in a game about numbers. */
.die__face,
.destiny-card__title,
.end-stat__value {
    -unity-font-definition: var(--font-strong);
}

/* Label style: Inter SemiBold, uppercase, tracked. */
.button,
.outcome,
.dice-panel__title,
.die-slot__name,
.nation-row__you,
.nation-row__stats,
.end-stat__label,
.nation-row__turn-mark {
    -unity-font-definition: var(--font-strong);
    -unity-font-style: normal;
}

/* Paper card with a flat offset shadow (thicker, darker bottom edge). */
.card {
    background-color: var(--paper);
    border-width: var(--border-width);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
}

/* Left column: who you are and what you want, then the nations panel */
.hud__left {
    position: absolute;
    left: var(--space-8);
    top: var(--space-8);
    /* Exactly the nations panel's width: --board-gutter-left is this column plus its margins, so the
       identity card (whatever its Wrath band holds) can never reach the board. */
    width: var(--nations-panel-width);
    align-items: stretch;
}

.hud__identity {
    flex-direction: row;
    align-items: center;
    /* At least as wide as the nations panel under it, so the left column reads as one and the card
       keeps its width. */
    min-width: var(--nations-panel-width);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
}

/* Chip and name share one head line, both centered on it, like a nation row. */
.hud__identity-head {
    flex-direction: row;
    align-items: center;
}

/* Icon, label, icon, label: the omen icons replace the ★ / ✗ glyphs (Inter's ✗ reads as "×"). */
.hud__identity-row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

/* "ZEUS", then the two numbers, then the Wrath: three short lines, nothing else. */
.hud__identity-name {
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0 0 0 var(--space-2);
}

.hud__identity-line {
    font-size: var(--font-size-body);
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.hud__identity-icon {
    margin-right: var(--space-1);
}

/* Space between "1 sacred" and the cursed pair, instead of a "·" separator. */
.hud__identity-icon--second {
    margin-left: var(--space-4);
}

/* Top center: round and Destiny, the loudest line on the HUD */
.hud__top {
    align-items: center;
}

/* Kept short by MatchText (the full story is in the round info panel); h2 like the turn banner.
   A row, so the "i" badge sits at its end. Wraps rather than clips if a line ever runs long. */
.hud__round {
    flex-direction: row;
    align-items: center;
    max-width: var(--round-line-width);
    padding: var(--space-2) var(--info-badge-gutter) var(--space-2) var(--info-badge-gutter);
    border-radius: var(--radius-md);
}

/* The round line's "i": fixed at the card's right edge, vertically centered, never in the flow. */
.hud__round > .info-badge {
    position: absolute;
    right: var(--space-3);
    top: 50%;
    margin-top: -14px;
}

/* Two lines: the Destiny line (h2) and, under it, the round counter (label, secondary), so the top
   of the screen never crams both facts into one line. */
.hud__round-lines {
    flex-shrink: 1;
    align-items: center;
    margin-right: var(--space-3);
}

.hud__round-text {
    white-space: normal;
    -unity-text-align: middle-center;
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.hud__round-counter {
    -unity-text-align: middle-center;
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    padding: 0;
    margin: 0;
}

/* Bottom center: prompt and actions */
.hud__bottom {
    align-items: center;
}

/* One-time onboarding hint, just above the prompt: a paper note pinned with a wood edge,
   so it reads as advice and never as a game state. */
.hud__hint {
    font-size: var(--font-size-body);
    color: var(--ink);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-left-color: var(--wood);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
    margin-top: var(--space-2);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* The action prompt: one paper bar for every prompt (turn, Road, Wrath aiming, refusals), like a note
   laid on the table. The acting god's chip and color edge say whose it is; a small label over the
   instruction says what kind of prompt it is. The instruction is h2 (Inter), readable at 1280x720. */
.prompt {
    flex-direction: row;
    align-items: center;
    max-width: var(--prompt-max-width);
    margin-bottom: var(--space-3);
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-4);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-md);
}

.prompt.god--zeus { border-left-color: var(--nation-zeus); }
.prompt.god--thor { border-left-color: var(--nation-thor); }
.prompt.god--ra { border-left-color: var(--nation-ra); }
.prompt.god--morrigan { border-left-color: var(--nation-morrigan); }

.prompt__text {
    flex-shrink: 1;
    margin-left: var(--space-4);
}

.prompt__turn {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    padding: 0;
    margin: 0;
}

.prompt__instruction {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    white-space: normal;
    padding: 0;
    margin: 0;
}

/* Sacred Road: the call to act, so its frame turns ink all round (the god's edge stays on the left). */
.prompt--road {
    border-top-color: var(--ink);
    border-right-color: var(--ink);
}

/* Three slots across the bottom: the two sides share the leftover width equally, so the center
   (END TURN, or the reinforcement counter) sits at the exact bottom center; the Wrath waits on its left. */
.hud__actions {
    align-self: stretch;
    flex-direction: row;
    align-items: center;
}

.hud__actions-side {
    flex-grow: 1;
    flex-basis: 0;
    flex-direction: row;
    align-items: center;
}

.hud__actions-side--left {
    justify-content: flex-end;
}

.hud__actions-center {
    flex-shrink: 0;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

/* END TURN: the main action of every turn, taller and wider than any other button. */
.button.button--end-turn {
    height: var(--action-button-height);
    padding: 0 var(--space-12);
    font-size: var(--font-size-body);
}

/* Nation chip: nation color + icon, so the god is never color alone */
.god-chip {
    width: var(--icon-lg);
    height: var(--icon-lg);
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--paper-shade);
    border-width: var(--border-width);
    border-color: var(--ink);
    border-radius: var(--radius-md);
}

.god-chip--lg {
    width: var(--chip-lg);
    height: var(--chip-lg);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-4);
}

.god-chip__icon {
    width: var(--icon-md);
    height: var(--icon-md);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink);
}

.god-chip--lg > .god-chip__icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
}

.god-chip.god--zeus { background-color: var(--nation-zeus); }
.god-chip.god--thor { background-color: var(--nation-thor); }
.god-chip.god--ra { background-color: var(--nation-ra); }
.god-chip.god--morrigan { background-color: var(--nation-morrigan); }

.god--zeus > .god-chip__icon { background-image: url("../Art/Placeholder/icon_zeus_bolt.png"); }
.god--thor > .god-chip__icon { background-image: url("../Art/Placeholder/icon_thor_hammer.png"); }
.god--ra > .god-chip__icon { background-image: url("../Art/Placeholder/icon_ra_sun.png"); }
.god--morrigan > .god-chip__icon {
    background-image: url("../Art/Placeholder/icon_morrigan_crow.png");
    -unity-background-image-tint-color: var(--paper);
}

/* Buttons */
.button {
    min-height: var(--button-min-height);
    margin: 0 var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-label);
    border-width: var(--border-width);
    /* color too: a mode button switching primary <-> secondary fades fill and text together,
       so its label never vanishes (wood on wood) mid-transition. */
    transition-property: background-color, border-color, color, translate, scale;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-enter);
}

/* The border matches the fill at rest, so hover can darken the frame without the button changing size. */
.button--primary {
    background-color: var(--wood);
    color: var(--paper);
    border-color: var(--wood);
}

.button--secondary {
    background-color: var(--clear);
    color: var(--wood);
    border-color: var(--wood);
}

/* Every pickable thing (buttons, god cards) answers hover the same way: lift, a slight grow, a darker frame. */
.button:hover {
    translate: var(--hover-lift);
    scale: var(--hover-scale);
}

.button--primary:hover {
    background-color: var(--wood-dark);
    border-color: var(--ink);
}

.button--secondary:hover {
    background-color: var(--paper-shade);
    border-color: var(--wood-dark);
}

/* Pressed: pushed back down onto the table. Declared after hover so it wins while held. */
.button:active {
    translate: 0 0;
    scale: var(--press-scale);
}

.button:disabled {
    background-color: var(--paper-shade);
    border-color: var(--paper-shade);
    color: var(--ink-faint);
    translate: 0 0;
    scale: 1 1;
}

/* Right: combat dice */
.dice-panel {
    position: absolute;
    right: var(--space-8);
    top: 50%;
    translate: 0 -50%;
    /* Fixed width: it is the --board-gutter-right the board is fitted beside, so it never covers it. */
    width: var(--dice-panel-width);
    align-items: center;
    padding: var(--space-4);
}

.dice-panel__title {
    font-size: var(--font-size-label);
    color: var(--ink);
    margin-bottom: var(--space-3);
}

.dice-panel__row {
    flex-direction: row;
}

.die-slot {
    align-items: center;
    margin: 0 var(--space-1);
}

.die-slot__name {
    font-size: var(--font-size-label);
    color: var(--ink-soft);
    margin-bottom: var(--space-2);
}

.die {
    width: var(--die-size);
    height: var(--die-size);
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-color: var(--paper);
    border-width: var(--die-border);
    border-color: var(--ink);
    border-radius: var(--radius-lg);
}

.die__face {
    font-size: var(--font-size-die);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

/* Sacred / cursed marks that stand on their own (die corners, outcome tags, god card tags, HUD identity
   line) are drawn icons, white on transparent and tinted here. Inside hint sentences the ★ / ✗ glyphs stay. */
.omen-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink);
}

.omen-icon--sacred { background-image: url("../Art/Placeholder/icon_sacred.png"); }

/* Cursed is desaturated like the cursed die: soft ink, never the nation color. */
.omen-icon--cursed {
    background-image: url("../Art/Placeholder/icon_cursed.png");
    -unity-background-image-tint-color: var(--ink-soft);
}

/* Corner mark: star burst on a sacred die, cracked die on a cursed one. Shown by the die outcome class. */
.die__mark {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: none;
}

/* Cursed crack: a diagonal split across the face, under the number. */
.die__crack {
    position: absolute;
    left: -21%;
    top: 50%;
    width: 142%;
    height: var(--die-border);
    background-color: var(--ink-faint);
    rotate: -45deg;
    display: none;
}

/* One class per god, shared by its die and outcome tag */
.die.god--zeus { border-color: var(--nation-zeus); }
.die.god--thor { border-color: var(--nation-thor); }
.die.god--ra { border-color: var(--nation-ra); }
.die.god--morrigan { border-color: var(--nation-morrigan); }

/* Sacred: thicker nation border and a glow of the nation tint. */
.die.die--sacred {
    border-width: var(--die-border-sacred);
}

.die--sacred.god--zeus { background-color: var(--nation-zeus-tint); }
.die--sacred.god--thor { background-color: var(--nation-thor-tint); }
.die--sacred.god--ra { background-color: var(--nation-ra-tint); }
.die--sacred.god--morrigan { background-color: var(--nation-morrigan-tint); }

.die--sacred > .die__mark--sacred {
    display: flex;
}

/* Cursed: desaturated (no nation color), cracked and marked. Declared after the god rules so it wins. */
.die.die--cursed {
    background-color: var(--paper-shade);
    border-color: var(--ink-faint);
}

.die--cursed > .die__face {
    color: var(--ink-soft);
}

.die--cursed > .die__crack,
.die--cursed > .die__mark--cursed {
    display: flex;
}

/* A short boxed tag under each die, "1 · SACRED": the drawn omen icon (sacred and cursed only), then the
   number and its outcome in capitals. Whose die it is comes from the god's tint and border and the
   name over the die. Both tags share one width and height, so the dice stay evenly spaced. */
.outcome {
    width: var(--outcome-tag-width);
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-1);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-color: var(--paper-shade);
    border-radius: var(--radius-sm);
}

.outcome__label {
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink);
    white-space: nowrap;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* The icon only appears for sacred and cursed; neutral is just the text. */
.outcome__icon {
    margin-right: var(--space-2);
    display: none;
}

/* The loser of the combat steps back: only its die fades; its tag stays fully readable. */
.die.die--loser {
    opacity: 0.6;
}

.outcome--sacred > .outcome__icon--sacred,
.outcome--cursed > .outcome__icon--cursed {
    display: flex;
}

.outcome.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.outcome.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.outcome.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.outcome.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

/* The verdict: one clear boxed "why" under the dice. The winner's chip and tint say who won (the
   sentence never repeats the name); the rule that decided it is the main line, in capitals at body
   size; badges (Offering re-roll, Ragnarök) are small chips under it. */
.verdict {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin-top: var(--space-4);
    padding: var(--space-3) var(--space-2);
    background-color: var(--paper-shade);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-color: var(--ink-faint);
    border-radius: var(--radius-md);
    visibility: hidden;
}

.verdict.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.verdict.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.verdict.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.verdict.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.verdict--shown {
    visibility: visible;
}

.verdict__chip {
    margin-right: var(--space-2);
}

.verdict__text {
    flex-grow: 1;
    flex-shrink: 1;
}

/* Over the headline when both dice read alike ("NEUTRAL VS NEUTRAL"): label size, soft ink. */
.verdict__kicker {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    white-space: normal;
    padding: 0;
    margin: 0 0 var(--space-1) 0;
    display: none;
}

.verdict__kicker.verdict__line--shown {
    display: flex;
}

.verdict__main {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    white-space: normal;
    padding: 0;
    margin: 0;
}

.verdict__badge {
    align-self: flex-start;
    margin: var(--space-2) 0 0 0;
    padding: var(--space-1) var(--space-2);
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--wood-dark);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-color: var(--wood);
    border-radius: var(--radius-sm);
    white-space: normal;
    display: none;
}

.verdict__badge.verdict__line--shown {
    display: flex;
}

/* Label size like the other "click" hints of the HUD, so the combat panel keeps to body and label. */
.dice-panel__continue {
    margin-top: var(--space-3);
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    /* Hidden, not removed: the panel keeps its final height so the dice never jump. */
    visibility: hidden;
}

/* --- Dice panel: optional Offering (owned by DiceView) ---
   A centered secondary button under the dice, the full width of the panel's content and at least a
   button tall. Hidden (still taking its room) until the human loses a combat they may re-roll; the
   timer bar drains over the Offering window, so its disappearance is expected. */
.button.dice-offering {
    visibility: hidden;
    align-self: stretch;
    min-height: var(--button-min-height);
    margin: var(--space-3) 0 0;
    padding: var(--space-2) var(--space-3) var(--space-1);
}

.dice-offering__label {
    font-size: var(--font-size-body);
    letter-spacing: var(--letter-spacing-label);
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--wood);
}

.dice-offering__timer {
    height: var(--space-1);
    margin-top: var(--space-1);
    background-color: var(--paper-shade);
    border-radius: var(--radius-sm);
    overflow: hidden;
}

.dice-offering__timer-fill {
    width: 100%;
    height: 100%;
    background-color: var(--wood);
}
/* --- End of dice panel Offering --- */

/* End of match */
.end-banner {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
}

/* The top edge takes the winner's color; the winner card inside carries its chip, name and why. */
.end-banner__card {
    min-width: var(--end-card-width);
    align-items: center;
    padding: var(--space-8) var(--space-12);
    border-top-width: var(--space-2);
}

.end-banner__card.god--zeus { border-top-color: var(--nation-zeus); }
.end-banner__card.god--thor { border-top-color: var(--nation-thor); }
.end-banner__card.god--ra { border-top-color: var(--nation-ra); }
.end-banner__card.god--morrigan { border-top-color: var(--nation-morrigan); }

.end-banner__title {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: var(--space-6);
}

/* Winner card: chip + name + reason on the winner's tint, like a god card laid on the table.
   With no winner (human eliminated) the chip and name hide and only the reason stays, untinted. */
.end-winner {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
    border-width: var(--border-width);
    border-color: var(--paper-shade);
}

.end-banner__card.god--zeus .end-winner { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.end-banner__card.god--thor .end-winner { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.end-banner__card.god--ra .end-winner { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.end-banner__card.god--morrigan .end-winner { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.end-winner > .god-chip--lg {
    margin-bottom: 0;
    margin-right: var(--space-4);
}

.end-winner__text {
    flex-shrink: 1;
}

.end-banner__winner {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.end-banner__reason {
    font-size: var(--font-size-body);
    color: var(--ink);
    white-space: normal;
    max-width: var(--end-card-width);
    padding: 0;
    margin: var(--space-1) 0 0 0;
}

/* Toasts (the news line and the one-time hint) live in the free corner of the right gutter, as wide as
   the combat panel, so they never straddle the board frame. The prompt bar is narrower, so they never
   meet it either. */
.hud__toasts {
    position: absolute;
    right: var(--space-8);
    bottom: var(--space-8);
    width: var(--dice-panel-width);
}

/* Sound and fast bots toggles, side by side at the top right */
.hud__toggles {
    position: absolute;
    right: var(--space-8);
    top: var(--space-8);
    flex-direction: row;
}

.hud__toggle {
    margin: 0 0 0 var(--space-2);
}

/* The open sound panel marks its button like an open info toggle: filled wood. */
.button.hud__toggle--open,
.button.hud__toggle--open:hover {
    background-color: var(--wood);
    border-color: var(--wood);
    color: var(--paper);
}

/* Sound panel (child selectors outrank the .info-panel__* rules declared further down): an info card hanging under the toggles, right-aligned so it never leaves the screen. */
.sound-panel {
    position: absolute;
    top: 100%;
    right: 0;
    width: 360px;
    margin-top: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
}

.sound-panel .sound-panel__heading {
    margin-top: 0;
}

.sound-panel__row {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-3);
}

.sound-panel .sound-panel__label {
    width: 72px;
    margin: 0;
    color: var(--ink);
}

/* Tall enough that the whole row height is the hit area. */
.sound-panel__slider {
    flex-grow: 1;
    min-height: 30px;
    margin: 0 var(--space-3);
}

.sound-panel .sound-panel__value {
    min-width: 56px;
    margin: 0;
    white-space: nowrap;
    -unity-text-align: middle-right;
}

/* Slider parts restyled with the parchment tokens: a soft ink groove, a wood fill up to the knob
   and a paper knob framed in wood. */
.sound-panel__slider .unity-base-slider__tracker {
    height: 8px;
    margin-top: -4px;
    background-color: var(--ink-soft);
    border-width: 0;
    border-radius: var(--radius-sm);
}

.sound-panel__slider .unity-base-slider__fill {
    background-color: var(--wood);
    border-radius: var(--radius-sm);
}

.sound-panel__slider .unity-base-slider__dragger {
    width: 22px;
    height: 22px;
    margin-top: -11px;
    background-color: var(--paper);
    border-width: var(--border-width);
    border-color: var(--wood);
    border-radius: 11px;
}

.sound-panel__slider:hover .unity-base-slider__dragger {
    border-color: var(--wood-dark);
    background-color: var(--paper-shade);
}

.sound-panel__slider:active .unity-base-slider__dragger {
    background-color: var(--wood);
}

.sound-panel__slider .unity-base-slider__dragger-border {
    display: none;
}

/* Nations panel: one row per god */
.nations-panel {
    width: var(--nations-panel-width);
    margin-top: var(--space-4);
    padding: var(--space-2);
}

/* The goal, always on screen: one quiet line heading the rows (sentence case at label size, like the
   outcome tags), so the ringed "3" dot in every row has its meaning written next to it. */
.nations-panel__goal {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    color: var(--ink-soft);
    white-space: normal;
    padding: 0 var(--space-2);
    margin: var(--space-1) 0 var(--space-2) 0;
}

.nation-row {
    flex-direction: row;
    align-items: center;
    padding: var(--space-2);
    border-width: var(--border-width);
    border-color: var(--clear);
    border-radius: var(--radius-md);
}

/* Whose turn: a wood frame, a paper-shade fill and the turn mark (never color alone). */
.nation-row--turn {
    border-color: var(--wood);
    background-color: var(--paper-shade);
}

.nation-row__turn-mark {
    width: var(--space-4);
    font-size: var(--font-size-label);
    color: var(--wood);
    padding: 0;
    margin: 0;
    visibility: hidden;
}

.nation-row--turn .nation-row__turn-mark {
    visibility: visible;
}

.nation-row__chip {
    width: var(--icon-md);
    height: var(--icon-md);
}

.nation-row__chip > .god-chip__icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
}

.nation-row__text {
    margin-left: var(--space-2);
    flex-grow: 1;
}

.nation-row__head {
    flex-direction: row;
    align-items: center;
    min-height: var(--info-badge-size);
    padding-right: var(--info-badge-reserve);
}

/* Chip, name, then the info key pushed to the head's right end (same x on every row). */
.nation-row__name {
    flex-grow: 1;
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0 0 0 var(--space-2);
}

/* The place in the drawn turn order, a small numbered tag right after the chip. */
.nation-row__place {
    margin-left: var(--space-2);
    padding: 0 var(--space-1);
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    color: var(--ink-soft);
    border-width: var(--border-width);
    border-color: var(--ink-faint);
    border-radius: var(--radius-sm);
}

.nation-row__you {
    margin-left: var(--space-2);
    padding: 0 var(--space-1);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-label);
    color: var(--paper);
    background-color: var(--wood);
    border-radius: var(--radius-sm);
}

.nation-row__stats {
    font-size: var(--font-size-label);
    color: var(--ink-soft);
    padding: 0;
    margin: var(--space-1) 0 0 0;
}

/* Temples held: the temple icon, then one large dot per temple (filled = held), readable at a glance. */
.nation-row__temple-line {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

.nation-row__temple-icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
    margin-right: var(--space-2);
    background-image: url("../Art/Placeholder/icon_temple.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink-soft);
}

/* One label per temple (created by NationsView), so the goal dot can be styled on its own. */
.nation-row__temples {
    flex-direction: row;
    align-items: center;
}

/* A fixed square box per dot (radius half its size), so the goal ring is a true circle. */
.nation-row__temple-dot {
    width: var(--temple-dot-size);
    height: var(--temple-dot-size);
    font-size: var(--font-size-h2);
    color: var(--ink);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    border-width: var(--border-width);
    border-color: var(--clear);
    border-radius: var(--radius-lg);
}

/* The dot that wins the match (TemplesToWin): ringed in --wood like a target. */
.nation-row__temple-dot--goal {
    border-color: var(--wood);
}

/* Empty, the goal ring holds its number ("3"), so the ring reads "the 3rd temple wins". */
.nation-row__temple-dot--goal-number {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    color: var(--wood);
}

/* Eliminated: faded, the stats line says "eliminated" and the temple line goes away. */
.nation-row--eliminated {
    opacity: 0.5;
}

.nation-row--eliminated .nation-row__temple-line {
    display: none;
}

/* Turn box: the one turn indicator, top right under the toggles. A paper card whose left edge, chip and
   icon are the acting god's ("THOR'S TURN" with a short status under it). When the turn changes it
   slides in from the right (turn-box--entering is set, then removed a moment later). */
.turn-box {
    position: absolute;
    right: var(--space-8);
    top: var(--turn-box-top);
    width: var(--turn-box-width);
    flex-direction: row;
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border-left-width: var(--space-2);
    border-radius: var(--radius-md);
    transition-property: translate, opacity;
    transition-duration: var(--duration-slow);
    transition-timing-function: var(--ease-enter);
}

.turn-box--entering {
    translate: var(--space-6) 0;
    opacity: 0;
}

.turn-box.god--zeus { border-left-color: var(--nation-zeus); }
.turn-box.god--thor { border-left-color: var(--nation-thor); }
.turn-box.god--ra { border-left-color: var(--nation-ra); }
.turn-box.god--morrigan { border-left-color: var(--nation-morrigan); }

.turn-box__text {
    flex-shrink: 1;
    margin-left: var(--space-3);
}

.turn-box__title {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.turn-box__status {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    color: var(--ink-soft);
    white-space: nowrap;
    padding: 0;
    margin: var(--space-1) 0 0 0;
}

/* Turn banner: above the top edge until shown, then slides down */
.turn-banner {
    position: absolute;
    left: 50%;
    top: var(--turn-banner-top);
    flex-direction: row;
    align-items: center;
    padding: var(--space-2) var(--space-6);
    border-left-width: var(--space-2);
    translate: -50% var(--turn-banner-hidden-offset);
    opacity: 0;
    transition-property: translate, opacity;
    transition-duration: var(--duration-slow);
    transition-timing-function: var(--ease-exit);
}

.turn-banner--shown {
    translate: -50% 0;
    opacity: 1;
    transition-timing-function: var(--ease-enter);
}

.turn-banner.god--zeus { border-left-color: var(--nation-zeus); }
.turn-banner.god--thor { border-left-color: var(--nation-thor); }
.turn-banner.god--ra { border-left-color: var(--nation-ra); }
.turn-banner.god--morrigan { border-left-color: var(--nation-morrigan); }

/* h2, like the round line above it: the HUD keeps to three text sizes. */
.turn-banner__label {
    margin-left: var(--space-4);
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
}

/* Sacred Road popup: a paper card centered at the top that rises into place (translate, scale and
   opacity transitions on the shown class) when a person's sacred die opens the road. It sits above
   the board's middle, not on it, and has no scrim: the rings it talks about stay in view. Only
   catches clicks while shown (picking set by C#). */
.road-popup {
    position: absolute;
    left: 50%;
    top: var(--road-popup-top);
    width: var(--road-popup-width);
    padding: var(--space-2) var(--space-6) var(--space-2) var(--space-4);
    border-left-width: var(--space-2);
    translate: -50% var(--space-4);
    scale: 0.94 0.94;
    opacity: 0;
    transition-property: translate, scale, opacity;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-exit);
}

.road-popup--shown {
    translate: -50% 0;
    scale: 1 1;
    opacity: 1;
    transition-timing-function: var(--ease-enter);
}

.road-popup.god--zeus { border-left-color: var(--nation-zeus); }
.road-popup.god--thor { border-left-color: var(--nation-thor); }
.road-popup.god--ra { border-left-color: var(--nation-ra); }
.road-popup.god--morrigan { border-left-color: var(--nation-morrigan); }

.road-popup__head {
    flex-direction: row;
    align-items: center;
}

.road-popup__title {
    margin-left: var(--space-4);
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    white-space: nowrap;
    padding: 0;
}

/* One short sentence after the title, filling the row up to "Click to close". */
.road-popup__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0 0 0 var(--space-4);
    font-size: var(--font-size-body);
    color: var(--ink);
    white-space: nowrap;
    padding: 0;
}

/* Same quiet closing line as the info panels, at the end of the title row. */
.road-popup__close {
    margin-left: var(--space-4);
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    padding: 0;
}

/* Destiny Die: a large die over a scrim at each round start */
.destiny-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
}

.destiny-card {
    align-items: center;
    min-width: var(--end-card-width);
    padding: var(--space-8) var(--space-12);
}

.destiny-card__title {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: var(--space-6);
}

/* A real die seen slightly from above: thick outline and a deeper bottom edge (its side), drawn in ink
   like the outline of the wooden pieces so the depth reads on every god color. Declared after the
   .die.god--* rules so the ink side wins. Not clipped, so the favored god's chip sits on the corner like a seal. */
.die.die--destiny {
    width: var(--die-size-destiny);
    height: var(--die-size-destiny);
    overflow: visible;
    border-width: var(--die-border-sacred);
    border-bottom-width: var(--die-edge-destiny);
    border-bottom-color: var(--ink);
    border-radius: var(--radius-lg);
}

.die--destiny > .die__face {
    font-size: var(--font-size-die-destiny);
}

/* Favored god: its color on the outline (from .die.god--*), its tint on the face, its chip on the corner. */
.die--destiny.god--zeus { background-color: var(--nation-zeus-tint); }
.die--destiny.god--thor { background-color: var(--nation-thor-tint); }
.die--destiny.god--ra { background-color: var(--nation-ra-tint); }
.die--destiny.god--morrigan { background-color: var(--nation-morrigan-tint); }

.destiny-card__chip {
    position: absolute;
    top: var(--space-2);
    right: var(--space-2);
    display: none;
}

.destiny-card__chip.god--zeus,
.destiny-card__chip.god--thor,
.destiny-card__chip.god--ra,
.destiny-card__chip.god--morrigan {
    display: flex;
}

.destiny-card__effect {
    margin-top: var(--space-6);
    font-size: var(--font-size-body);
    color: var(--ink);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: var(--round-line-width);
}

/* What the face does to the human, on their tint with their color as the border (like .outcome). */
.destiny-card__you {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    color: var(--ink);
    border-width: var(--border-width);
    border-radius: var(--radius-sm);
}

.destiny-card__you.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.destiny-card__you.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.destiny-card__you.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.destiny-card__you.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.destiny-card__skip {
    margin-top: var(--space-2);
    font-size: var(--font-size-caption);
    color: var(--ink-soft);
}

/* Main menu */
.menu {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--scrim);
}

.menu__card {
    align-items: center;
}

.menu__screen {
    align-items: center;
}

.menu__screen--home {
    width: 600px;
    max-width: 90%;
    align-items: center;
    padding: 36px 44px 36px 44px;
    background-color: var(--paper);
    border-width: 2px;
    border-color: rgba(200, 160, 70, 0.4);
    border-bottom-width: 6px;
    border-bottom-color: rgba(139, 94, 60, 0.45);
    border-radius: var(--radius-lg);
}

.menu__pantheon-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
}

.menu__pantheon-chip {
    margin: 0 var(--space-2);
}

.menu__divider {
    width: 260px;
    height: 1px;
    background-color: rgba(200, 160, 70, 0.35);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
}

.menu__screen--select {
    width: 1536px;
    max-width: 96%;
    align-items: center;
    padding: var(--space-6) var(--space-8) var(--space-8) var(--space-8);
}

.menu__screen--content {
    width: 1100px;
    max-width: 94%;
    align-items: center;
    padding: var(--space-8) var(--space-8);
}

.menu__nav-group {
    width: 380px;
    align-items: center;
}

.menu__nav-btn {
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 12px var(--space-4);
    font-size: 15px;
    -unity-font-definition: var(--font-strong);
    letter-spacing: 1.5px;
    justify-content: center;
    align-items: center;
    border-radius: var(--radius-md);
    border-width: 1px;
    border-color: rgba(139, 94, 60, 0.35);
    background-color: rgba(251, 246, 236, 0.95);
    color: var(--ink);
    transition-property: translate, scale, background-color, border-color;
    transition-duration: var(--duration-fast);
}

.menu__nav-btn:hover {
    background-color: var(--paper-shade);
    border-color: var(--wood);
    color: var(--ink);
}

.menu__nav-btn--primary {
    font-size: 20px;
    letter-spacing: 2px;
    padding: 16px var(--space-6);
    margin-bottom: 12px;
    border-radius: var(--radius-md);
    background-color: var(--wood);
    color: var(--paper);
    border-width: 2px;
    border-color: #D4AF37;
    border-bottom-width: 4px;
    border-bottom-color: var(--wood-dark);
}

.menu__nav-btn--primary:hover {
    background-color: var(--wood-dark);
    border-color: #E5C158;
}

.menu__header-bar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom-width: 1px;
    border-bottom-color: var(--border-soft);
}

.menu__back-btn {
    width: 150px;
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-caption);
    -unity-text-align: middle-center;
}

.menu__header-spacer {
    width: 150px;
}

.menu__screen-title {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--ink);
    margin: 0;
    padding: 0;
}

.menu__content-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.menu__info-box {
    width: 48%;
    background-color: var(--bg-card);
    border-width: 1px;
    border-color: var(--border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
}

.menu__info-box-title {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--gold);
    margin-bottom: var(--space-2);
}

.menu__info-box-text {
    font-size: var(--font-size-caption);
    color: var(--ink-soft);
    white-space: normal;
}

.menu__deities-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    width: 100%;
}

.menu__deity-box {
    width: 48%;
    background-color: var(--bg-card);
    border-width: 1px;
    border-color: var(--border-soft);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
}

.menu__deity-box.god--zeus { border-color: var(--nation-zeus); background-color: var(--nation-zeus-tint); }
.menu__deity-box.god--ra { border-color: var(--nation-ra); background-color: var(--nation-ra-tint); }
.menu__deity-box.god--thor { border-color: var(--nation-thor); background-color: var(--nation-thor-tint); }
.menu__deity-box.god--morrigan { border-color: var(--nation-morrigan); background-color: var(--nation-morrigan-tint); }

.menu__deity-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

.menu__deity-title-group {
    margin-left: var(--space-3);
}

.menu__deity-name {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--ink);
}

.menu__deity-subtitle {
    font-size: var(--font-size-caption);
    color: var(--gold);
}

.menu__deity-desc {
    font-size: var(--font-size-caption);
    color: var(--ink-soft);
    white-space: normal;
}

.hud__road-skip {
    min-height: var(--button-min-height);
    padding: var(--space-2) var(--space-4);
    font-size: var(--font-size-caption);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    border-color: var(--gold);
}

.menu__title {
    font-size: 56px;
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--ink);
    letter-spacing: 4px;
    padding: 0;
    margin: 0;
}

.menu__tagline {
    font-size: 15px;
    -unity-font-definition: var(--font-strong);
    color: var(--wood);
    letter-spacing: 1.5px;
    margin-top: var(--space-1);
    -unity-text-align: middle-center;
}

/* Body size (not label) so the menu keeps to three text sizes: display, h2, body. */
.menu__prompt {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    padding: 0;
    margin: 0;
}

/* The prompt under the mode toggles, which already separate it from the title. */
.menu__prompt-row {
    flex-direction: row;
    align-items: center;
    min-height: var(--button-min-height);
    margin-top: var(--space-4);
    margin-bottom: var(--space-4);
}


.menu__cards {
    flex-direction: row;
}

/* The sacred-number rule under the cards: hidden from menu per design request; full rules are in How To Play */
.menu__rule {
    display: none;
    align-items: center;
    margin-top: var(--space-6);
}

.menu__rule-row {
    flex-direction: row;
    align-items: center;
}

.menu__rule-text {
    font-size: var(--font-size-body);
    color: var(--ink-soft);
    padding: 0;
    margin: 0;
}

.menu__rule-icon {
    margin: 0 var(--space-1);
}

/* God card: the same frame for every god; only the band tint, chip and numbers change */
/* flex-grow: each card fills its template container, so all four stand at the same height. */
.god-card {
    width: var(--god-card-width);
    flex-grow: 1;
    margin: 0 var(--space-2);
    align-items: center;
    padding-bottom: var(--space-6);
    overflow: hidden;
    background-color: var(--paper);
    border-width: var(--border-width);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-lg);
    transition-property: translate, scale, border-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-enter);
}

/* Hover lifts the card off the table and frames it in wood: "this one is pickable". */
.god-card:hover {
    translate: var(--hover-lift);
    scale: var(--hover-scale);
    border-color: var(--wood);
    border-bottom-color: var(--wood-dark);
}

.god-card:active {
    translate: 0 0;
    scale: var(--press-scale);
}

.god-card__band {
    align-self: stretch;
    align-items: center;
    padding: var(--space-6) 0;
    margin-bottom: var(--space-4);
}

.god-card.god--zeus > .god-card__band { background-color: var(--nation-zeus-tint); }
.god-card.god--thor > .god-card__band { background-color: var(--nation-thor-tint); }
.god-card.god--ra > .god-card__band { background-color: var(--nation-ra-tint); }
.god-card.god--morrigan > .god-card__band { background-color: var(--nation-morrigan-tint); }

.god-card__chip {
    margin-bottom: 0;
}

.god-card__name {
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: var(--space-3);
}

/* Sacred and cursed numbers as small die-like tags, using the same language as the dice:
   sacred glows in the god's tint and color, cursed is desaturated paper-shade. */
.god-card__tag {
    flex-direction: row;
    align-items: center;
    padding: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0 0;
    border-width: var(--border-width);
    border-radius: var(--radius-sm);
}

.god-card__tag-icon {
    margin-right: var(--space-2);
}

.god-card__tag-text {
    font-size: var(--font-size-body);
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.god-card__cursed {
    background-color: var(--paper-shade);
    border-color: var(--ink-faint);
}

.god-card.god--zeus .god-card__sacred { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.god-card.god--thor .god-card__sacred { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.god-card.god--ra .god-card__sacred { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.god-card.god--morrigan .god-card__sacred { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.god-card__rival {
    font-size: var(--font-size-body);
    color: var(--ink-soft);
    padding: 0;
    margin: var(--space-3) 0 0 0;
}

/* End screen: three stats split by thin paper-shade dividers, then two actions */
.end-stats {
    flex-direction: row;
    justify-content: center;
    margin-top: var(--space-6);
    margin-bottom: var(--space-8);
}

.end-stat {
    align-items: center;
    padding: 0 var(--space-6);
}

#stat-temples,
#stat-combats {
    border-left-width: var(--border-width);
    border-left-color: var(--paper-shade);
}

.end-stat__value {
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.end-stat__label {
    font-size: var(--font-size-label);
    color: var(--ink-soft);
    letter-spacing: var(--letter-spacing-label);
}

.end-banner__actions {
    flex-direction: row;
    justify-content: center;
}

/* God powers (Pantheon powers mode). Placeholder styling with existing tokens; every element is
   hidden in Classic. Game-state lines (news, Day) wear the god's tint and color, like .outcome;
   advice (.hud__hint) keeps its wood edge, so the two never look alike. */

/* HUD identity: the Wrath, the loudest line of the card. Its carved name (Cinzel h2) and the Favor
   stars (Inter h2, ink) on the god's tint with a nation-color edge, like the Day badge: it is that
   god's power. Never "ready": the Wrath button says that. */
.hud__wrath {
    /* Name over stars, so the band never makes the left column wider than the nations panel. */
    flex-direction: column;
    align-items: flex-start;
    align-self: stretch;
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-radius: var(--radius-sm);
}

.hud__wrath.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.hud__wrath.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.hud__wrath.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.hud__wrath.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.hud__wrath-name {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0;
}

.hud__favor {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    padding: 0;
    margin: 0;
    transition-property: scale, opacity;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-enter);
}

/* A Favor meter (identity card or nation row) answering a star: it grows when one arrives, and
   dims for a moment when a cursed roll cracks one. Added and removed by the views. */
.favor--bump {
    scale: var(--favor-bump-scale);
}

.favor--dim {
    opacity: var(--favor-dim-opacity);
}

/* The star that flies from a sacred combat die to its god's Favor: the sacred star burst in the
   nation color over an ink one (the outline, like the wooden pieces), so even Zeus's light blue
   reads on parchment. Pooled by HudView; it never takes a click. */
.favor-star {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--favor-star-size);
    height: var(--favor-star-size);
    visibility: hidden;
}

.favor-star__back,
.favor-star__front {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("../Art/Placeholder/icon_sacred.png");
}

.favor-star__back {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-image-tint-color: var(--ink);
}

.favor-star__front {
    left: var(--space-2);
    top: var(--space-2);
    right: var(--space-2);
    bottom: var(--space-2);
}

.favor-star.god--zeus > .favor-star__front { -unity-background-image-tint-color: var(--nation-zeus); }
.favor-star.god--thor > .favor-star__front { -unity-background-image-tint-color: var(--nation-thor); }
.favor-star.god--ra > .favor-star__front { -unity-background-image-tint-color: var(--nation-ra); }
.favor-star.god--morrigan > .favor-star__front { -unity-background-image-tint-color: var(--nation-morrigan); }

/* Its quiet counterpart: a cracked-die mark that sinks and fades over a meter that lost a star. */
.favor-crack {
    position: absolute;
    left: 0;
    top: 0;
    width: var(--icon-md);
    height: var(--icon-md);
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("../Art/Placeholder/icon_cursed.png");
    -unity-background-image-tint-color: var(--ink-soft);
    visibility: hidden;
}

/* Under the round line while a round-long Day lasts (Ragnarök, Night of crows). */
.hud__day-badge {
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-radius: var(--radius-sm);
    -unity-text-align: middle-center;
}

/* What a power just did, above the hint. A row, so a Favor change can lead with the drawn omen icon
   (like the HUD identity line): Inter's ✗ glyph reads as "×" at body size. */
.hud__news {
    flex-direction: row;
    align-items: center;
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-4);
    margin-top: var(--space-2);
}

.hud__news-text {
    flex-shrink: 1;
    white-space: normal;
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    color: var(--ink);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
}

.hud__news-icon {
    margin-right: var(--space-2);
    display: none;
}

.hud__news--sacred > .hud__news-icon--sacred,
.hud__news--cursed > .hud__news-icon--cursed {
    display: flex;
}

.hud__day-badge.god--zeus, .hud__news.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.hud__day-badge.god--thor, .hud__news.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.hud__day-badge.god--ra, .hud__news.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.hud__day-badge.god--morrigan, .hud__news.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

/* The Wrath button: the god's signature power, not a grey "disabled" button. A big tile with the god's
   icon, the Wrath's name in carved capitals over its state, and the three Favor stars. Four states set
   by HudView as classes next to the god class, all drawn with ink and the god's own colors:
     locked  paper face, a frame in the god's color, stars filling up ("FAVOR 1/3" or "NO TARGET")
     ready   solid nation color, ink frame, white stars, a halo ring and a slow breath
     used    quiet paper-shade face ("USED THIS TURN")
     aiming  paper face in wood ("CLICK TO CANCEL")
   The .wrath.wrath--* selectors out-rank .button:disabled, so a locked Wrath keeps its face. */
.button.wrath {
    flex-direction: row;
    align-items: center;
    min-width: var(--wrath-button-min-width);
    height: var(--wrath-button-height);
    margin: 0 var(--space-4) 0 0;
    padding: 0 var(--space-4) 0 var(--space-3);
    border-width: var(--space-1);
    border-bottom-width: var(--space-2);
    background-color: var(--paper);
    /* The breath is slow; hover, press and color changes stay fast. */
    transition-property: background-color, border-color, translate, scale;
    transition-duration: var(--duration-fast), var(--duration-fast), var(--duration-fast), var(--duration-slow);
}

.wrath__icon {
    width: var(--icon-lg);
    height: var(--icon-lg);
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.wrath > .wrath__icon {
    -unity-background-image-tint-color: var(--ink);
}

.wrath__text {
    flex-grow: 1;
    justify-content: center;
}

.wrath__name {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-h2);
    -unity-font-style: bold;
    color: var(--ink);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

.wrath__state {
    -unity-font-definition: var(--font-strong);
    font-size: var(--font-size-label);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    white-space: nowrap;
    padding: 0;
    margin: 0;
}

/* Three Favor stars: the drawn sacred star, pale when empty, nation color on an ink outline when full. */
.wrath__stars {
    flex-direction: row;
    flex-shrink: 0;
    margin-left: var(--space-3);
}

.wrath__star {
    width: var(--wrath-star-size);
    height: var(--wrath-star-size);
    margin-left: var(--space-1);
}

.wrath__star-back,
.wrath__star-front {
    position: absolute;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("../Art/Placeholder/icon_sacred.png");
}

.wrath__star-back {
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-background-image-tint-color: var(--ink-faint);
}

.wrath__star-front {
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    display: none;
}

.wrath__star--on > .wrath__star-back { -unity-background-image-tint-color: var(--ink); }
.wrath__star--on > .wrath__star-front { display: flex; }

/* A full star is solid ink here, like the "★" of the identity card and the nation rows: one fill everywhere. */
.wrath__star--on > .wrath__star-front { -unity-background-image-tint-color: var(--ink); }

/* The halo: a ring just outside the button, only while ready. */
.wrath__halo {
    position: absolute;
    left: var(--wrath-halo-offset);
    top: var(--wrath-halo-offset);
    right: var(--wrath-halo-offset);
    bottom: var(--wrath-halo-offset);
    border-width: var(--space-1);
    border-color: var(--clear);
    border-radius: var(--radius-lg);
    opacity: 0.35;
    display: none;
    transition-property: opacity;
    transition-duration: var(--duration-slow);
    transition-timing-function: var(--ease-enter);
}

/* Locked: the god's frame on paper. */
.button.wrath.wrath--locked.god--zeus { border-color: var(--nation-zeus); }
.button.wrath.wrath--locked.god--thor { border-color: var(--nation-thor); }
.button.wrath.wrath--locked.god--ra { border-color: var(--nation-ra); }
.button.wrath.wrath--locked.god--morrigan { border-color: var(--nation-morrigan); }

/* Used: the same frame on a quiet face. */
.button.wrath.wrath--used {
    background-color: var(--paper-shade);
}

.button.wrath.wrath--used.god--zeus { border-color: var(--nation-zeus); }
.button.wrath.wrath--used.god--thor { border-color: var(--nation-thor); }
.button.wrath.wrath--used.god--ra { border-color: var(--nation-ra); }
.button.wrath.wrath--used.god--morrigan { border-color: var(--nation-morrigan); }

.wrath--used .wrath__name { color: var(--ink-soft); }

/* Ready: the god's own power. A solid nation-color tile in an ink frame with a deeper bottom edge (a
   painted token, like the pieces), white stars, a halo ring and a slow breath (wrath--pulse, toggled
   by HudView). Text is ink; paper on Morrígan's black. */
.button.wrath.wrath--ready {
    border-color: var(--ink);
}

.button.wrath.wrath--ready.god--zeus { background-color: var(--nation-zeus); }
.button.wrath.wrath--ready.god--thor { background-color: var(--nation-thor); }
.button.wrath.wrath--ready.god--ra { background-color: var(--nation-ra); }
.button.wrath.wrath--ready.god--morrigan { background-color: var(--nation-morrigan); }

.wrath--ready .wrath__state { color: var(--ink); }
.wrath--ready.god--morrigan .wrath__name,
.wrath--ready.god--morrigan .wrath__state { color: var(--paper); }
.wrath.wrath--ready.god--morrigan > .wrath__icon { -unity-background-image-tint-color: var(--paper); }
.wrath.wrath--ready .wrath__star--on > .wrath__star-front { -unity-background-image-tint-color: var(--paper); }

.wrath--ready > .wrath__halo { display: flex; }
.wrath--ready.god--zeus > .wrath__halo { border-color: var(--nation-zeus); }
.wrath--ready.god--thor > .wrath__halo { border-color: var(--nation-thor); }
.wrath--ready.god--ra > .wrath__halo { border-color: var(--nation-ra); }
.wrath--ready.god--morrigan > .wrath__halo { border-color: var(--nation-morrigan); }

.wrath--ready.wrath--pulse > .wrath__halo { opacity: 1; }

/* Hover keeps the god's color and frames it in wood-dark; the lift and grow come from .button:hover. */
.button.wrath.wrath--ready:hover {
    border-color: var(--wood-dark);
}

/* A locked or used Wrath does not answer the pointer: no lift, no grow, no press. */
.button.wrath.wrath--locked:hover,
.button.wrath.wrath--locked:active,
.button.wrath.wrath--used:hover,
.button.wrath.wrath--used:active {
    translate: 0 0;
    scale: 1 1;
}

/* Aiming: back to paper, framed in wood, so it reads as "back out" rather than "strike". */
.button.wrath.wrath--aiming {
    border-color: var(--wood);
}

.wrath--pulse {
    scale: var(--wrath-pulse-scale);
}

/* Destiny Die: the Day line, under the effect, on the god's tint with its color (like the "You" line). */
.destiny-card__day {
    margin-top: var(--space-3);
    padding: var(--space-1) var(--space-3);
    font-size: var(--font-size-body);
    -unity-font-style: bold;
    color: var(--ink);
    border-width: var(--border-width);
    border-radius: var(--radius-sm);
    white-space: normal;
    max-width: var(--round-line-width);
    -unity-text-align: middle-center;
}

.destiny-card__day.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.destiny-card__day.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.destiny-card__day.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.destiny-card__day.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

/* Menu: Pantheon powers / Classic, side by side; the selected one is the primary button. */
.menu__modes {
    flex-direction: row;
    margin-top: var(--space-6);
}


.menu__mode-line {
    font-size: var(--font-size-body);
    color: var(--ink-soft);
    margin-top: var(--space-2);
    -unity-text-align: middle-center;
}

/* Two lines, "Storm: enemies -1, to Zeus" / "Thunderbolt: halve an army": the names are <b>, which
   Inter maps to SemiBold. Body size, so the menu keeps display, h2 and body only. */
.god-card__powers {
    font-size: var(--font-size-body);
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-center;
    padding: 0 var(--space-2);
    margin: var(--space-2) 0 0 0;
}

/* Nations panel: the Favor stars "★★☆" alone, in ink (the word "Favor" lives in the powers card);
   the meter takes the god's tint and color when full (never color alone: the stars carry the count),
   bumps when a star arrives and dims when one cracks (.favor--bump / .favor--dim). */
.nation-row__favor-line {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-1);
}

.nation-row__favor {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    padding: 0 var(--space-1);
    margin: 0;
    border-width: var(--border-width);
    border-color: var(--clear);
    border-radius: var(--radius-sm);
    transition-property: scale, opacity;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-enter);
}

.nation-row__favor--full.god--zeus { background-color: var(--nation-zeus-tint); border-color: var(--nation-zeus); }
.nation-row__favor--full.god--thor { background-color: var(--nation-thor-tint); border-color: var(--nation-thor); }
.nation-row__favor--full.god--ra { background-color: var(--nation-ra-tint); border-color: var(--nation-ra); }
.nation-row__favor--full.god--morrigan { background-color: var(--nation-morrigan-tint); border-color: var(--nation-morrigan); }

.nation-row--eliminated .nation-row__favor-line {
    display: none;
}

/* Small nation chip (round info rows), the nations panel size. */
.god-chip--sm {
    width: var(--icon-md);
    height: var(--icon-md);
}

.god-chip--sm > .god-chip__icon {
    width: var(--icon-sm);
    height: var(--icon-sm);
}

/* Info toggles (the round line, a nation row with powers): the whole thing is the hit area and the
   "i" badge says it can be opened. The badge is a small key: a rounded square (never round, so it can't
   be read as a temple dot), paper-shade fill, wood frame and a bold wood "i". Hover follows the
   pickable language on the badge (lift, grow, darker frame); open, it turns solid wood. It is a label,
   not a Button, so one click never toggles twice. */
.info-badge {
    width: var(--info-badge-size);
    height: var(--info-badge-size);
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-strong);
    -unity-font-style: bold;
    font-size: var(--font-size-label);
    color: var(--wood);
    background-color: var(--paper-shade);
    border-width: var(--border-width);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--wood);
    border-radius: var(--radius-sm);
    transition-property: background-color, border-color, color, translate, scale;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-enter);
}

.info-toggle {
    transition-property: border-color, background-color;
    transition-duration: var(--duration-fast);
    transition-timing-function: var(--ease-enter);
}

.info-toggle:hover .info-badge {
    translate: var(--hover-lift);
    scale: var(--hover-scale);
    background-color: var(--paper);
    border-color: var(--wood-dark);
    color: var(--wood-dark);
}

/* Pressed: pushed down, the deeper bottom edge flattens like a key. */
.info-toggle:active .info-badge {
    translate: 0 0;
    scale: var(--press-scale);
    border-bottom-width: var(--border-width);
}

.info-toggle--open .info-badge,
.info-toggle--open:hover .info-badge {
    background-color: var(--wood);
    border-color: var(--wood);
    color: var(--paper);
}

/* The round line frames itself in wood on hover, like a god card. */
.hud__round.info-toggle:hover,
.hud__round.info-toggle--open {
    border-color: var(--wood);
    border-bottom-color: var(--wood-dark);
}

/* A nation row's hover frame is paper-shade, so it never reads as the wood "whose turn" frame. */
.nation-row.info-toggle:hover {
    border-color: var(--ink-faint);
}

.nation-row--turn.info-toggle:hover {
    border-color: var(--wood);
}

/* Anchored to the head's top-right corner: same spot on every row whatever the tags or name. */
.nation-row__info {
    position: absolute;
    top: 0;
    right: 0;
    flex-shrink: 0;
    display: none;
}

.nation-row.info-toggle .nation-row__info {
    display: flex;
}

/* Explanations in full sentences: label headings (what it is), body text (what it does). */
.info-panel {
    display: none;
}

.info-panel__heading {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    white-space: normal;
    padding: 0;
    margin: var(--space-3) 0 0 0;
}

.info-panel__text {
    font-size: var(--font-size-body);
    color: var(--ink);
    white-space: normal;
    padding: 0;
    margin: var(--space-1) 0 0 0;
}

.info-panel__text--soft {
    color: var(--ink-soft);
}

.info-panel__close {
    align-self: center;
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink-soft);
    padding: 0;
    margin: var(--space-4) 0 0 0;
}

/* Round info: under the round line (and the Day badge), centered. Absolute, so however long a Day's
   text runs it lies over the board and never pushes the prompt and actions down at 1280x720. */
.round-info {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    width: var(--info-panel-width);
    margin-top: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border-radius: var(--radius-md);
}

#round-info-title {
    margin-top: 0;
}

.round-info__god {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-2);
}

.round-info__god-text {
    flex-shrink: 1;
    margin: 0 0 0 var(--space-3);
}

/* A god's powers card, a flyout to the right of its row, aligned with it: paper with the nation
   color on the left edge (the row beside it carries the chip and the open "i", so the color is never
   alone). Absolute, so opening it never pushes the rows below off the screen at 1280x720; wider than
   the panel, so its sentences wrap to a few lines and even Morrígan's card (the last row) fits. */
.nation-powers {
    position: absolute;
    left: 100%;
    top: 0;
    width: var(--powers-card-width);
    margin-left: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-left-width: var(--space-2);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-md);
}

/* The lower two rows open upward (bottom-aligned with their row), so their cards stay clear of the
   prompt and actions at the bottom of the screen. */
#nation-thor > .nation-powers,
#nation-morrigan > .nation-powers {
    top: auto;
    bottom: 0;
}

.nation-powers.god--zeus { border-left-color: var(--nation-zeus); }
.nation-powers.god--thor { border-left-color: var(--nation-thor); }
.nation-powers.god--ra { border-left-color: var(--nation-ra); }
.nation-powers.god--morrigan { border-left-color: var(--nation-morrigan); }

.nation-powers__day-heading {
    margin-top: 0;
}

/* Reinforcement counter: troops still to place, in a die-like token in the action slot (where END TURN
   appears once they are all placed). The number pops on every placement, like a piece that gains a troop. */
.reinforce-counter {
    flex-direction: row;
    align-items: center;
    margin: 0 var(--space-2);
    padding: var(--space-2) var(--space-6) var(--space-2) var(--space-2);
    border-radius: var(--radius-md);
}

.reinforce-counter__count {
    width: var(--counter-token-size);
    height: var(--counter-token-size);
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-strong);
    font-size: var(--font-size-h1);
    color: var(--ink);
    padding: 0;
    margin: 0;
    background-color: var(--paper);
    border-width: var(--die-border);
    border-color: var(--ink);
    border-radius: var(--radius-md);
    transition-property: scale;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-enter);
}

.reinforce-counter__count--pop {
    scale: var(--pop-scale);
}

.reinforce-counter__text {
    margin-left: var(--space-4);
}

.reinforce-counter__label {
    font-size: var(--font-size-label);
    -unity-font-definition: var(--font-strong);
    letter-spacing: var(--letter-spacing-label);
    color: var(--ink);
    padding: 0;
    margin: 0;
}

/* Where this turn's troops came from ("2 base + 1 for 2 territories + 2 Destiny"), quiet under the
   caption, so the prompt line above can say only whose turn it is. */
.reinforce-counter__formula {
    font-size: var(--font-size-label);
    color: var(--ink-soft);
    padding: 0;
    margin: var(--space-1) 0 0 0;
}

/* Turn-order draw (before round 1): a scrim and a card like the Destiny Die's, with the dice of the
   duel under a heading, the boxed verdict, then the final order as four numbered god cards. */
.draw-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    /* The card sits on the board's centre: the same insets as the board area (HudView), so it is
       centred on the board horizontally and vertically, not on the raw screen. */
    padding: var(--board-gutter-top) var(--board-gutter-right) var(--board-gutter-bottom) var(--board-gutter-left);
    background-color: var(--scrim-light);
    opacity: 1;
    transition-property: opacity;
    transition-duration: var(--duration-slow);
    transition-timing-function: var(--ease-exit);
}

.draw-overlay--hidden {
    opacity: 0;
}

.draw-card {
    align-items: center;
    justify-content: center;
    width: var(--draw-card-width);
    height: var(--draw-card-height);
    padding: var(--space-6) var(--space-8);
}

.draw-card__title {
    -unity-font-definition: var(--font-display);
    font-size: var(--font-size-h1);
    -unity-font-style: bold;
    color: var(--ink);
    margin-bottom: var(--space-1);
}

.draw-card__duel {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-strong);
    color: var(--ink-soft);
    margin-bottom: var(--space-6);
}

/* Pinned to the bottom centre of the fixed card, out of the content's flow. */
.draw-card__skip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--space-4);
    margin: 0;
    -unity-text-align: middle-center;
}

.draw-card__block {
    align-self: stretch;
    align-items: center;
}

.draw-card__row {
    flex-direction: row;
    justify-content: center;
}

/* The two slots are wider apart than the combat dice: a duel is the whole card. */
.draw-card__row > .die-slot {
    margin: 0 var(--space-6);
}

.draw-card__row .god-chip {
    margin-bottom: var(--space-2);
}

.draw-card__row .die-slot__name {
    margin-bottom: var(--space-3);
}

.draw-card__row .outcome {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
}

/* Verdict text centred on the box; the winner's chip always sits at the right edge (hidden, its
   place kept, on a tie), and the text keeps equal side room so it never shifts. */
.draw-card__verdict .verdict__chip {
    position: absolute;
    right: var(--space-2);
    top: 50%;
    translate: 0 -50%;
    margin: 0;
}

.draw-card__verdict .verdict__text {
    padding: 0 var(--space-8);
    align-items: center;
}

.draw-card__verdict .verdict__main,
.draw-card__verdict .verdict__kicker {
    -unity-text-align: middle-center;
}

.draw-card__verdict {
    justify-content: center;
    align-self: stretch;
    height: var(--draw-verdict-height);
    margin-top: var(--space-6);
}

.draw-card__final {
    flex-direction: row;
    justify-content: center;
}

/* One numbered god card: the place on top, the chip, the name; it pops in one after another. */
.draw-place {
    align-items: center;
    margin: 0 var(--space-2);
    padding: var(--space-4) var(--space-2);
    width: var(--draw-place-width);
    background-color: var(--paper);
    border-width: var(--border-width);
    border-top-width: var(--space-2);
    border-bottom-width: var(--shadow-offset);
    border-color: var(--paper-shade);
    border-bottom-color: var(--shadow);
    border-radius: var(--radius-md);
    opacity: 0;
    scale: 0.9 0.9;
    transition-property: opacity, scale;
    transition-duration: var(--duration-base);
    transition-timing-function: var(--ease-enter);
}

.draw-place--shown {
    opacity: 1;
    scale: 1 1;
}

.draw-place.god--zeus { border-top-color: var(--nation-zeus); background-color: var(--nation-zeus-tint); }
.draw-place.god--thor { border-top-color: var(--nation-thor); background-color: var(--nation-thor-tint); }
.draw-place.god--ra { border-top-color: var(--nation-ra); background-color: var(--nation-ra-tint); }
.draw-place.god--morrigan { border-top-color: var(--nation-morrigan); background-color: var(--nation-morrigan-tint); }

.draw-place__badge {
    font-size: var(--font-size-h2);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
    margin-bottom: var(--space-2);
}

.draw-place__name {
    font-size: var(--font-size-body);
    -unity-font-definition: var(--font-strong);
    color: var(--ink);
}

/* Destiny names (round bar, round info heading, Destiny card effect) lead with their icon: the favored
   god's chip, or the sacred / cursed mark for good fortune / bad omen. Shown by GodUss.ApplyDestinyIcon. */
.destiny-name {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.destiny-name--heading {
    margin-top: var(--space-3);
    justify-content: flex-start;
}

.destiny-name--heading > .info-panel__heading { margin-top: 0; }

.destiny-name--effect { margin-top: var(--space-6); }

.destiny-name--effect > .destiny-card__effect { margin-top: 0; }

.destiny-name__icon {
    display: none;
    margin-right: var(--space-2);
}
