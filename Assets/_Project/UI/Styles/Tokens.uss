/* Design tokens. Mirrors Docs/design-system.md: if a value changes, change both. */
:root {
    /* Nations (Okabe-Ito) */
    --nation-zeus: #56B4E9;
    --nation-thor: #D55E00;
    --nation-ra: #E69F00;
    --nation-morrigan: #1A1A1A;
    --nation-zeus-tint: #D6E9F0;
    --nation-thor-tint: #EBCDB4;
    --nation-ra-tint: #F2DDB0;
    --nation-morrigan-tint: #CFC7BA;

    /* Paper and ink */
    --parchment: #F2E8D5;
    --paper: #FBF6EC;
    --paper-shade: #E4D7BF;
    --wood: #8B5E3C;
    --wood-dark: #6B4529;
    --ink: #2B2118;
    --ink-soft: #6E5F4E;
    --ink-faint: #A89580;
    --scrim: rgba(43, 33, 24, 0.45);
    --scrim-light: rgba(43, 33, 24, 0.18);
    --clear: rgba(43, 33, 24, 0);
    /* Flat paper shadow: drawn as a thicker bottom border (USS has no box-shadow) */
    --shadow: #D2C2A4;
    --shadow-offset: 4px;

    /* Typefaces (UI Toolkit font assets, Dynamic atlas pre-filled with every glyph the game uses).
       Inter Regular maps bold to Inter SemiBold through its weight table. */
    --font-display: url("/Assets/_Project/Fonts/Cinzel SDF.asset");
    --font-body: url("/Assets/_Project/Fonts/Inter-Regular SDF.asset");
    --font-strong: url("/Assets/_Project/Fonts/Inter-SemiBold SDF.asset");

    /* Type scale */
    --font-size-display: 64px;
    --font-size-h1: 40px;
    --font-size-h2: 28px;
    --font-size-body: 20px;
    --font-size-label: 16px;
    --font-size-caption: 14px;
    --font-size-die: 96px;
    --font-size-die-destiny: 128px;
    --letter-spacing-label: 1px;

    /* Spacing and shape */
    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-6: 24px;
    --space-8: 32px;
    --space-12: 48px;
    --radius-sm: 4px;
    --radius-md: 8px;
    --radius-lg: 16px;
    --border-width: 2px;

    /* Component sizes */
    --button-min-height: 48px;
    --icon-md: 32px;
    --icon-lg: 48px;
    --chip-lg: 80px;
    --die-size: 140px;
    --die-border: 4px;
    --die-border-sacred: 8px;
    /* Width of the outcome tag under each combat die: "1 · SACRED" with its icon on one line */
    --outcome-tag-width: 144px;
    --round-line-width: 800px;
    --end-card-width: 480px;
    /* Turn-order draw card: one fixed size for every duel, tie, verdict and the final order */
    --draw-card-width: 680px;
    --draw-card-height: 650px;
    --draw-place-width: 128px;
    --draw-verdict-height: 88px;
    --icon-sm: 20px;
    --nations-panel-width: 300px;
    /* Wide enough that every power line (Day, Wrath) fits on one line at body size */
    --god-card-width: 352px;
    /* The Wrath button: icon, carved name over its state, the three Favor stars. Wide and tall enough
       that locked, ready, used and aiming never resize it */
    --wrath-button-min-width: 420px;
    --wrath-button-height: 84px;
    --wrath-star-size: 36px;
    /* How far the ready Wrath's halo ring stands outside the button */
    --wrath-halo-offset: -10px;
    /* END TURN and SKIP ROAD match the Wrath button's height for a unified, symmetrical action bar */
    --action-button-height: 84px;
    /* The action prompt above the buttons: one paper bar (god chip, label, instruction) for every prompt */
    --prompt-max-width: 900px;
    /* The turn box: top right, under the sound and fast-bots toggles */
    --turn-box-width: 288px;
    --turn-box-top: 96px;
    /* Combat panel (right): two dice, a tag under each, and the boxed verdict */
    --dice-panel-width: 352px;
    /* Free table kept clear for the board: what the panels, toggles and bottom actions leave. The camera
       fits the board frame inside it (BoardCameraFit), so no panel ever covers the board at any aspect.
       Left = screen padding + nations panel + gap; right = screen padding + combat panel + gap. */
    --board-gutter-left: 416px;
    --board-gutter-right: 416px;
    --board-gutter-top: 160px;
    --board-gutter-bottom: 232px;
    /* Fixed box of each temple dot, so the ringed goal dot is a circle around its "3" */
    --temple-dot-size: 32px;
    /* The star that flies from a sacred combat die to its god's Favor stars */
    --favor-star-size: 72px;
    --die-size-destiny: 200px;
    /* Thicker bottom edge of the Destiny Die: the side of a real die seen slightly from above */
    --die-edge-destiny: 16px;
    /* Just under the round line, in the table's top margin (it covers a Day badge for its few seconds,
       rather than the top row of the board) */
    --turn-banner-top: 108px;
    --turn-banner-hidden-offset: -288px;
    /* The Sacred Road popup, centered above the board's middle row: wide enough for its sentence in two
       lines; starts just under the round line (covering a round-long Day badge instead of leaving a
       sliver of it) and ends above the north temple */
    --road-popup-width: 1160px;
    --road-popup-top: 108px;
    /* The round "i" badge that says "click for the full explanation" (round line, nation rows) */
    --info-badge-size: 28px;
    /* Space a row/bar reserves on its right for the absolutely anchored "i" badge (badge + 8px) */
    --info-badge-reserve: 36px;
    /* Same for the round line, whose badge sits 12px from the card edge (badge + 2 x 12px) */
    --info-badge-gutter: 52px;
    /* Max width of the round info panel under the round line */
    --info-panel-width: 720px;
    /* A nation's powers card, a flyout beside its row in the nations panel */
    --powers-card-width: 400px;
    /* The die-like token of the reinforcement counter */
    --counter-token-size: 72px;

    /* Motion */
    --duration-fast: 120ms;
    --duration-base: 200ms;
    --duration-slow: 400ms;
    /* Things arriving decelerate; things leaving accelerate */
    --ease-enter: ease-out-cubic;
    --ease-exit: ease-in-cubic;
    --hover-lift: 0 -2px;
    --hover-scale: 1.02 1.02;
    --press-scale: 0.97 0.97;
    /* A count that just changed pops, like a piece that gains a troop */
    --pop-scale: 1.15 1.15;
    /* A Favor meter that just changed (a star arrived, or one cracked) */
    --favor-bump-scale: 1.3 1.3;
    /* The ready Wrath button breathes between rest and this scale */
    --wrath-pulse-scale: 1.04 1.04;
    /* A Favor meter that just lost a star dims to this opacity for a moment */
    --favor-dim-opacity: 0.4;
}
